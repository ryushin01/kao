{
  "outDir": "src/app/styles/fonts",
  "restDir": "public/fonts",
  "scan": ["src", "server"],
  "dataExtensions": ["json", "vue"],
  "extra": "년월일시분초오전후요화수목금토",
  "fonts": [
    {
      "family": "KaoSans",
      "slug": "kao-sans",
      "rename": true,
      "weights": {
        "400": "scripts/fonts/kao-sans/KaoSans-400.woff2",
        "500": "scripts/fonts/kao-sans/KaoSans-500.woff2",
        "700": "scripts/fonts/kao-sans/KaoSans-700.woff2"
      }
    },
    {
      "family": "Orbit",
      "slug": "orbit",
      "text": "scripts/fonts/titles.mjs",
      "weights": {
        "400": "scripts/fonts/orbit/Orbit-Regular.woff2"
      }
    }
  ]
}
